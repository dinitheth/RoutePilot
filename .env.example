# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.5 or newer: gemini-3.7-flash, gemini-3.1-pro-preview).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model alias or full model name for RoutePilot Agent (Default: gemini-3.7-flash)
GEMINI_MODEL="gemini-3.7-flash"

# GOOGLE_MAPS_API_KEY: Google Maps Platform API key (Places API New, Routes API, Maps JS)
# Users can provide their GCP Maps key or Maps Demo Key for prototyping
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Public client key if rendering frontend map (optional, server proxy supported)
VITE_GOOGLE_MAPS_API_KEY=""

# GOOGLE_CLOUD_PROJECT: Google Cloud project ID for Cloud Run and Firestore
GOOGLE_CLOUD_PROJECT=""

# APP_URL: The URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"

